<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="immogest.controleur.Controleur" fx:id="racine" style="-fx-font-size: 14px; -fx-background-color: #f7f8fa;">
<padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
<top><VBox spacing="14"><Label text="ImmoGest" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #203d52;"/><HBox spacing="10"><Button text="Accueil" onAction="#accueil"/><Button text="Données" onAction="#donnees"/><Button text="Biens disponibles" onAction="#biens"/><Button text="Signer un bail" onAction="#signature"/><Button text="Quittances" onAction="#quittances"/></HBox><Separator/></VBox></top>
<center><VBox spacing="18"><padding><Insets top="20"/></padding><Label text="Signature et état des lieux d’entrée" style="-fx-font-size: 24px;"/><Label text="Dates : AAAA-MM-JJ. La date de fin est exclue de la période."/><GridPane hgap="18" vgap="14"><Label text="Bien" GridPane.rowIndex="0"/><ComboBox fx:id="bien" prefWidth="660" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="Locataire" GridPane.rowIndex="1"/><ComboBox fx:id="locataire" prefWidth="660" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Gestionnaire" GridPane.rowIndex="2"/><ComboBox fx:id="gestionnaire" prefWidth="660" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Label text="Début du bail" GridPane.rowIndex="3"/><TextField fx:id="debut" GridPane.columnIndex="1" GridPane.rowIndex="3"/><Label text="Fin du bail" GridPane.rowIndex="4"/><TextField fx:id="fin" GridPane.columnIndex="1" GridPane.rowIndex="4"/><Label text="Date de l’état des lieux" GridPane.rowIndex="5"/><TextField fx:id="dateEtat" GridPane.columnIndex="1" GridPane.rowIndex="5"/><Label text="Défauts (facultatif)" GridPane.rowIndex="6"/><TextField fx:id="defauts" promptText="Sépare les défauts par des points-virgules" GridPane.columnIndex="1" GridPane.rowIndex="6"/></GridPane><Button text="Enregistrer le bail et l’état des lieux" onAction="#signer"/><Label text="Les deux enregistrements sont réalisés ensemble."/></VBox></center><bottom><Label fx:id="message" wrapText="true" style="-fx-text-fill: #9d2424; -fx-padding: 15 0 0 0;"/></bottom></BorderPane>
