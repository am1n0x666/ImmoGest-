<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="immogest.controleur.Controleur" fx:id="racine" style="-fx-font-size: 14px; -fx-background-color: #f7f8fa;">
<padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
<top><VBox spacing="14"><Label text="ImmoGest" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #203d52;"/><HBox spacing="10"><Button text="Accueil" onAction="#accueil"/><Button text="Données" onAction="#donnees"/><Button text="Biens disponibles" onAction="#biens"/><Button text="Signer un bail" onAction="#signature"/><Button text="Quittances" onAction="#quittances"/></HBox><Separator/></VBox></top>
<center><VBox spacing="16"><padding><Insets top="20"/></padding><Label text="Enregistrer les données" style="-fx-font-size: 24px;"/><Label text="Bien immobilier" style="-fx-font-weight: bold;"/><HBox spacing="8"><ComboBox fx:id="type" prefWidth="170"/><TextField fx:id="adresse" promptText="Adresse"/><TextField fx:id="ville" promptText="Ville"/></HBox><HBox spacing="8"><TextField fx:id="surface" promptText="Surface en m²"/><TextField fx:id="loyer" promptText="Loyer de base"/><Button text="Ajouter le bien" onAction="#ajouterBien"/></HBox><Separator/><Label text="Locataire" style="-fx-font-weight: bold;"/><HBox spacing="8"><TextField fx:id="nom" promptText="Nom"/><TextField fx:id="telephone" promptText="Téléphone"/><TextField fx:id="email" promptText="Email"/><Button text="Ajouter le locataire" onAction="#ajouterLocataire"/></HBox><Separator/><Label text="Gestionnaire" style="-fx-font-weight: bold;"/><HBox spacing="8"><TextField fx:id="nomGestionnaire" promptText="Nom"/><TextField fx:id="matricule" promptText="Matricule"/><Button text="Ajouter le gestionnaire" onAction="#ajouterGestionnaire"/></HBox></VBox></center><bottom><Label fx:id="message" wrapText="true" style="-fx-text-fill: #9d2424; -fx-padding: 15 0 0 0;"/></bottom></BorderPane>
