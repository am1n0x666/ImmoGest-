<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="immogest.controleur.Controleur" fx:id="racine" style="-fx-font-size: 14px; -fx-background-color: #f7f8fa;">
<padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
<top><VBox spacing="14"><Label text="ImmoGest" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #203d52;"/><HBox spacing="10"><Button text="Accueil" onAction="#accueil"/><Button text="Données" onAction="#donnees"/><Button text="Biens disponibles" onAction="#biens"/><Button text="Signer un bail" onAction="#signature"/><Button text="Quittances" onAction="#quittances"/></HBox><Separator/></VBox></top>
<center><VBox spacing="18"><padding><Insets top="20"/></padding><Label text="Biens disponibles" style="-fx-font-size: 24px;"/><HBox spacing="12"><ComboBox fx:id="type" prefWidth="190"/><TextField fx:id="ville" promptText="Ville"/><TextField fx:id="maximum" promptText="Loyer max. charges comprises" prefWidth="250"/></HBox><HBox spacing="12"><Label text="Du"/><TextField fx:id="debut" prefWidth="150"/><Label text="au (exclu)"/><TextField fx:id="fin" prefWidth="150"/><Button text="Rechercher" onAction="#rechercher"/></HBox><TableView fx:id="tableau" prefHeight="350"><columns><TableColumn fx:id="colonneType" text="Type" prefWidth="180"/><TableColumn fx:id="colonneAdresse" text="Adresse" prefWidth="300"/><TableColumn fx:id="colonneVille" text="Ville" prefWidth="210"/><TableColumn fx:id="colonneLoyer" text="Loyer hors charges" prefWidth="210"/></columns></TableView><Button text="Ouvrir le formulaire de bail" onAction="#signature"/></VBox></center><bottom><Label fx:id="message" wrapText="true" style="-fx-text-fill: #9d2424; -fx-padding: 15 0 0 0;"/></bottom></BorderPane>
